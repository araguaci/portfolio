---
import BaseHead from '@/components/BaseHead'
import Header from '@/components/Header'
import Footer from '@/components/Footer'
import ProviderTheme from '@/components/ProviderTheme'
import ProviderAnimations from '@/components/ProviderAnimations'
import TwSizeIndicator from '@/components/TwSizeIndicator'
import EditBlog from '@/components/editBlog'
import GoTop from '@/components/GoTop'
import PWABanner from '@/components/PWABanner.astro'
import { siteConfig } from '@/site-config'

const { title, description, image, articleDate } = Astro.props
---

<html lang={siteConfig.lang} class='scroll-smooth'>
	<head>
		<BaseHead title={title} description={description} ogImage={image} articleDate={articleDate} />
		<ProviderTheme />
		<ProviderAnimations />
	</head>

	<body class='flex flex-col min-h-screen'>
		<!-- Sticky Top Header Navigation -->
		<Header />

		<!-- Main Page Content -->
		<main
			class='flex-1 px-4 sm:px-6 md:px-8 max-w-6xl mx-auto w-full antialiased grid gap-10 mt-4 overflow-hidden md:overflow-visible'
		>
			<slot />
		</main>

		<!-- Branded Footer -->
		<Footer />

		<!-- Interactive Overlays & Utilities -->
		<PWABanner />
		<TwSizeIndicator />
		<GoTop />
		<EditBlog />

		<style>
			body {
				margin-left: calc(100vw - 100%); /* prevent layout shift */
			}
		</style>
	</body>
</html>
