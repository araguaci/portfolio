---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '@/components/FormattedDate'
import BaseLayout from '@/layouts/BaseLayout'
import Tag from '@/components/Tag'
import ArticleLinks from '@/components/ArticleLinks'
import type { MarkdownHeading } from 'astro'
import { Image } from 'astro:assets'

type Props = {
	id: CollectionEntry<'blog'>['id']
	data: CollectionEntry<'blog'>['data']
	headings: MarkdownHeading[]
	readTime: string
}

const { data, readTime, headings, id } = Astro.props
if (!data) throw new Error('BlogPost: data is required')
const { title, description, pubDate, heroImage, tags, links } = data

const articleDate = pubDate.toISOString()
const ogImageSrc = typeof heroImage === 'string' ? heroImage : heroImage?.src
---

<BaseLayout title={title} description={description} image={ogImageSrc} articleDate={articleDate}>
	<article class='min-w-full md:py-4 sm:max-w-none md:max-w-none'>
		<header class='mb-3 flex flex-col justify-center items-center gap-6'>
			<div class='flex flex-col gap-2'>
				<div class='flex items-center justify-center gap-x-1'>
					<p
						class='text-center font-mono text-xs tracking-wide text-[var(--as-text-ink-muted)] dark:text-[var(--as-text-muted)]'
					>
						Publicado <FormattedDate date={pubDate} />
					</p>
					<p class='text-center font-mono text-xs tracking-wide text-[var(--as-golden-amber)]'>
						{readTime}
					</p>
				</div>
				<h1 class='font-display text-center text-4xl md:text-6xl md:pb-2.5 font-semibold'>
					{title}
				</h1>
			</div>

			<div class='flex flex-wrap justify-center items-center gap-2 gap-y-4 md:gap-5'>
				{tags.map((tag) => <Tag tag={tag} />)}
			</div>

			{links && links.length > 0 && <ArticleLinks links={links} />}
		</header>

		<>
			{
				heroImage &&
					(typeof heroImage === 'string' ? (
						<img
							src={heroImage}
							width={1000}
							height={500}
							loading='eager'
							class='rounded-md w-full max-h-[300px] md:max-h-[500px] my-8 object-cover'
							alt={`img of ${title}`}
						/>
					) : (
						<Image
							src={heroImage}
							width={1000}
							height={500}
							quality={100}
							format='jpg'
							loading='eager'
							class='rounded-md w-full max-h-[300px]  md:max-h-[500px] my-8 object-cover'
							alt={`img of ${title}`}
						/>
					))
			}
		</>

		<hr />

		<div>
			<slot />
		</div>
	</article>
</BaseLayout>

<script>
	const fnObserver = () => {
		function handleIntersection(
			entries: IntersectionObserverEntry[],
			observer: IntersectionObserver
		) {
			entries.forEach((entry) => {
				const index = document.querySelector(`aside a[href="#${entry.target.id}"]`)

				if (entry.isIntersecting) {
					index?.classList.add('toc-current')
				} else {
					index?.classList.remove('toc-current')
				}
			})
		}

		const headings = document.querySelectorAll(
			'div.prose h1, div.prose h2, div.prose h3, div.prose h4, div.prose h5, div.prose h6'
		)

		const options = {
			root: null,
			rootMargin: ' 15% 0px 0% 0px ',
			threshold: 1
		}

		const observer = new IntersectionObserver(handleIntersection, options)

		headings.forEach((heading) => {
			observer.observe(heading)
		})
	}
	fnObserver()
	document.addEventListener('astro:after-swap', fnObserver)
</script>
