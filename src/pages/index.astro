---
// src/pages/index.astro — Masterpiece Portfolio Artes do Sul
import HeroMasterpiece from '@/components/HeroMasterpiece.astro'
import PortfolioList from '@/components/PortfolioList.astro'
import InteractiveSimulator from '@/components/InteractiveSimulator.astro'
import ListCategories from '@/components/ListCategories.astro'
import ListPosts from '@/components/ListPosts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts } from '@/utils'

const MAX_POSTS = 5
const posts = await getPosts(MAX_POSTS)
---

<BaseLayout title='Início'>
	<!-- 1. Masterpiece Hero Section (Cinematic Visual, Overlays, Badges) -->
	<HeroMasterpiece />

	<!-- 2. Acervo de Projetos em Produção (Growth Tracker, Search & Filters) -->
	<PortfolioList />

	<!-- 3. Simulador Interativo & Motor de Briefing Executivo -->
	<InteractiveSimulator />

	<!-- 4. Diário de Bordo & Artigos Técnicos -->
	<section id='diario' class='pt-8 space-y-6'>
		<div
			class='flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b pb-4 border-[var(--as-border-paper)] dark:border-[var(--border)]'
		>
			<div class='as-section-label'>
				<span class='as-kicker'>// DIÁRIO DE DESENVOLVIMENTO</span>
				<h2>Artigos & Estudos Técnicos</h2>
				<p
					class='text-xs sm:text-sm text-[var(--as-text-ink-muted)] dark:text-[var(--as-text-muted)] max-w-xl'
				>
					Reflexões, investigações, notas de arquitetura e ensaios sobre engenharia, filosofia e
					sociedade.
				</p>
			</div>

			<a href='/posts/1' class='as-link font-mono text-xs hover:text-[var(--accent-orange)]'>
				Ver todos os artigos →
			</a>
		</div>

		<!-- Category Filter Tabs for Posts -->
		<ListCategories />

		<!-- Posts Grid -->
		<ListPosts FirstBig={true} posts={posts} />
	</section>
</BaseLayout>
