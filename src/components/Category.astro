---
import { cn, sluglify } from '@/utils'

const { name = 'Ver todos', activeCategory } = Astro.props
const currentPath = Astro.url.pathname
const unsluglifyNameCategory = sluglify(name.toLowerCase())

const isActive =
	activeCategory?.toLocaleLowerCase() === unsluglifyNameCategory ||
	(currentPath === '/' && (name === 'View All' || name === 'Ver todos'))
---

<a
	href={name === 'Ver todos' ? '/' : sluglify(`/category/${unsluglifyNameCategory}/1`)}
	class={cn('as-cat first-letter:uppercase', isActive && 'is-active')}
>
	{name}
</a>
