---
import { getThumbnailUrl } from '@/utils'
import type { Projeto } from '@/utils'

const { projeto } = Astro.props
const thumbnailUrl = projeto.thumbnail ?? getThumbnailUrl(projeto.url)
---

<article class='group grid min-h-full grid-rows-[200px_auto] overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm transition-all duration-200 hover:border-stone-300 hover:shadow-md dark:border-stone-700 dark:bg-stone-900 dark:hover:border-stone-600'>
	<a
		href={projeto.url}
		target='_blank'
		rel='noopener noreferrer'
		class='relative block overflow-hidden bg-stone-100 dark:bg-stone-800'
		aria-label={`Abrir ${projeto.titulo}`}
	>
		<img
			src={thumbnailUrl}
			alt={`Screenshot de ${projeto.titulo}`}
			width={400}
			height={200}
			class='h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]'
			loading='lazy'
			onerror="this.src='https://placehold.co/400x200/f8fafc/94a3b8?text=Preview'"
		/>
		<div class='absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/5 dark:group-hover:bg-black/10' />
	</a>

	<div class='flex flex-col gap-3 p-4'>
		<div class='flex flex-col gap-1'>
			<a
				href={projeto.url}
				target='_blank'
				rel='noopener noreferrer'
				class='text-lg font-semibold tracking-tight text-stone-900 hover:text-stone-600 dark:text-white dark:hover:text-stone-300'
			>
				{projeto.titulo}
			</a>
			<p class='line-clamp-2 text-sm text-stone-600 dark:text-stone-400'>
				{projeto.descricao}
			</p>
		</div>

		<div class='flex flex-wrap gap-1.5'>
			{projeto.tags.slice(0, 4).map((tag) => (
				<span
					class='rounded-md bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-600 dark:bg-stone-800 dark:text-stone-400'
				>
					{tag}
				</span>
			))}
		</div>

		<a
			href={projeto.url}
			target='_blank'
			rel='noopener noreferrer'
			class='mt-auto text-sm font-medium text-stone-600 underline-offset-2 hover:underline dark:text-stone-400'
		>
			Visitar projeto →
		</a>
	</div>
</article>
