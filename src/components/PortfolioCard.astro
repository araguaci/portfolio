---
// PortfolioCard.astro — Masterpiece Card com Growth Tracker, Copy Link e Cyber Glassmorphism
import { sluglify } from '@/utils'

const { projeto } = Astro.props
const thumbnailUrl = projeto.thumbnail ?? ''
const projectId = sluglify(projeto.titulo.toLowerCase())

let hostname = 'online'
try {
	const rawUrl = projeto.url || ''
	const fullUrl = rawUrl.startsWith('http') ? rawUrl : `https://${rawUrl}`
	hostname = new URL(fullUrl).hostname.replace(/^www\./, '')
} catch {
	hostname = projeto.url || 'online'
}
---

<article
	class='as-card group relative flex flex-col justify-between h-full overflow-hidden rounded-2xl border border-[var(--as-border-paper)] dark:border-[var(--border)] bg-[var(--as-bg-paper-card)] dark:bg-[var(--bg-card)] transition-all duration-300'
>
	<!-- Thumbnail Section with Image Overlay and Status -->
	<div class='relative w-full h-48 overflow-hidden bg-black/5 dark:bg-black/40'>
		<a
			href={projeto.url}
			target='_blank'
			rel='noopener noreferrer'
			class='project-link block w-full h-full'
			data-project-id={projectId}
			aria-label={`Visitar ${projeto.titulo}`}
		>
			{
				thumbnailUrl ? (
					<img
						src={thumbnailUrl}
						alt={`Screenshot do site ${projeto.titulo}`}
						width={400}
						height={200}
						class='h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105'
						loading='lazy'
					/>
				) : (
					<div class='flex h-full w-full flex-col items-center justify-center gap-2 font-mono text-xs text-[var(--as-text-dim)] bg-gradient-to-br from-white/5 to-white/0'>
						<span class='text-xl'>⚡</span>
						<span>{projeto.titulo}</span>
					</div>
				)
			}
			<!-- Gradient Overlay -->
			<div
				class='absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity'
			>
			</div>
		</a>

		<!-- Floating Top Utilities (Online Badge, Favorite, Copy Link) -->
		<div
			class='absolute top-3 inset-x-3 flex items-center justify-between z-10 pointer-events-auto'
		>
			<!-- Online Indicator -->
			<span
				class='inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono font-medium bg-black/60 backdrop-blur-md text-emerald-400 border border-emerald-500/30'
			>
				<span class='w-1.5 h-1.5 rounded-full bg-emerald-400'></span>
				ONLINE
			</span>

			<div class='flex items-center gap-1.5'>
				<!-- Copy Link Button (Skill requirement) -->
				<button
					type='button'
					class='copy-project-btn p-1.5 rounded-lg bg-black/60 backdrop-blur-md text-white/70 hover:text-white hover:bg-black/80 border border-white/10 transition-colors'
					data-url={projeto.url}
					title='Copiar link do projeto'
					aria-label='Copiar link do projeto'
				>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						width='14'
						height='14'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2'
						stroke-linecap='round'
						stroke-linejoin='round'
					>
						<rect width='14' height='14' x='8' y='8' rx='2' ry='2'></rect>
						<path d='M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2'></path>
					</svg>
				</button>

				<!-- Favorite Button (Growth Tracker) -->
				<button
					type='button'
					class='favorite-btn p-1.5 rounded-lg bg-black/60 backdrop-blur-md text-white/70 hover:text-amber-400 hover:bg-black/80 border border-white/10 transition-colors'
					data-project-id={projectId}
					title='Salvar nos favoritos'
					aria-label='Salvar nos favoritos'
				>
					<span class='star-icon text-xs leading-none font-bold'>☆</span>
				</button>
			</div>
		</div>
	</div>

	<!-- Card Body Content -->
	<div class='flex flex-col flex-1 p-5 gap-3.5'>
		<div class='flex flex-col gap-1.5'>
			<a
				href={projeto.url}
				target='_blank'
				rel='noopener noreferrer'
				class='project-link font-display text-lg font-bold tracking-tight text-[var(--as-text-ink)] dark:text-white group-hover:text-[var(--accent-orange)] transition-colors line-clamp-1'
				data-project-id={projectId}
			>
				{projeto.titulo}
			</a>
			<p
				class='line-clamp-2 text-xs leading-relaxed text-[var(--as-text-ink-muted)] dark:text-[var(--as-text-muted)]'
			>
				{projeto.descricao}
			</p>
		</div>

		<!-- Tags Grid -->
		<div class='flex flex-wrap gap-1.5 mt-auto pt-2'>
			{
				projeto.tags
					.slice(0, 3)
					.map((tag: string) => <span class='as-chip text-[10px]'>{tag}</span>)
			}
			{
				projeto.tags.length > 3 && (
					<span class='font-mono text-[10px] text-[var(--as-text-dim)] self-center'>
						+{projeto.tags.length - 3}
					</span>
				)
			}
		</div>

		<!-- Card Action Link -->
		<div
			class='pt-3 border-t border-[var(--as-border-paper)] dark:border-[var(--border)] flex items-center justify-between'
		>
			<a
				href={projeto.url}
				target='_blank'
				rel='noopener noreferrer'
				class='project-link as-link text-xs font-semibold'
				data-project-id={projectId}
			>
				<span>Acessar Projeto</span>
				<span
					class='font-mono transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5'
					>↗</span
				>
			</a>
			<span class='font-mono text-[10px] text-[var(--as-text-dim)] truncate max-w-[130px]'>
				{hostname}
			</span>
		</div>
	</div>
</article>

<script>
	const setupCardInteractions = () => {
		// Copy Button Logic with Toast Feedback
		document.querySelectorAll('.copy-project-btn').forEach((btn) => {
			if (btn.getAttribute('data-bound') === 'true') return
			btn.setAttribute('data-bound', 'true')

			btn.addEventListener('click', async (e) => {
				e.stopPropagation()
				const url = btn.getAttribute('data-url')
				if (!url) return

				try {
					await navigator.clipboard.writeText(url)
					const originalHTML = btn.innerHTML
					btn.innerHTML = `<span class="text-emerald-400 font-mono text-[10px]">✓</span>`
					setTimeout(() => {
						btn.innerHTML = originalHTML
					}, 2000)
				} catch (err) {
					console.error('Falha ao copiar:', err)
				}
			})
		})

		// Favorite Toggle Logic with LocalStorage
		document.querySelectorAll('.favorite-btn').forEach((btn) => {
			if (btn.getAttribute('data-bound') === 'true') return
			btn.setAttribute('data-bound', 'true')

			btn.addEventListener('click', (e) => {
				e.stopPropagation()
				const id = btn.getAttribute('data-project-id')
				if (!id) return

				const favs: string[] = JSON.parse(localStorage.getItem('artesdosul_favorites') || '[]')
				const index = favs.indexOf(id)

				if (index > -1) {
					favs.splice(index, 1)
				} else {
					favs.push(id)
				}

				localStorage.setItem('artesdosul_favorites', JSON.stringify(favs))
				window.dispatchEvent(new CustomEvent('artesdosul:tracker_update'))
			})
		})

		// Mark as Explored when visited
		document.querySelectorAll('.project-link').forEach((link) => {
			if (link.getAttribute('data-bound') === 'true') return
			link.setAttribute('data-bound', 'true')

			link.addEventListener('click', () => {
				const id = link.getAttribute('data-project-id')
				if (!id) return

				const explored: string[] = JSON.parse(localStorage.getItem('artesdosul_explored') || '[]')
				if (!explored.includes(id)) {
					explored.push(id)
					localStorage.setItem('artesdosul_explored', JSON.stringify(explored))
					window.dispatchEvent(new CustomEvent('artesdosul:tracker_update'))
				}
			})
		})
	}

	setupCardInteractions()
	document.addEventListener('astro:after-swap', setupCardInteractions)
</script>
