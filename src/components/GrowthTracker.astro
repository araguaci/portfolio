---
// GrowthTracker.astro — Rastreador de Exploração e Engajamento com Persistência Local
interface Props {
	totalProjects: number
}

const { totalProjects } = Astro.props
---

<div
	id='growth-tracker-container'
	class='p-5 rounded-2xl border border-[var(--as-border-paper)] dark:border-[var(--border)] bg-[var(--as-bg-paper-card)] dark:bg-[var(--bg-card)] backdrop-blur-md shadow-sm mb-6 transition-all duration-300'
>
	<div class='flex flex-col md:flex-row items-start md:items-center justify-between gap-4'>
		<!-- Title & Metric -->
		<div class='flex flex-col gap-1'>
			<div class='flex items-center gap-2'>
				<span
					class='font-mono text-xs uppercase tracking-wider text-[var(--accent-orange)] font-semibold'
				>
					// GROWTH TRACKER
				</span>
				<span
					class='text-[11px] font-mono px-2 py-0.2 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
				>
					LOCAL PERSISTENCE
				</span>
			</div>
			<div class='flex items-baseline gap-2'>
				<h3 class='font-display text-lg font-bold text-[var(--as-text-ink)] dark:text-white'>
					Progresso de Exploração do Acervo
				</h3>
				<span
					id='tracker-percentage-text'
					class='font-mono text-sm font-semibold text-[var(--accent-cyan)]'
				>
					0%
				</span>
			</div>
			<p class='text-xs text-[var(--as-text-ink-muted)] dark:text-[var(--as-text-muted)]'>
				Explore os projetos, favorite com <strong class='text-amber-400'>★</strong> e rastreie sua navegação
				salva em seu dispositivo.
			</p>
		</div>

		<!-- Quick Filter Controls & Reset -->
		<div class='flex flex-wrap items-center gap-2 font-mono text-xs'>
			<button
				type='button'
				id='tracker-filter-all'
				class='tracker-filter-btn px-3 py-1.5 rounded-lg border border-[var(--accent-orange)] bg-[var(--accent-orange)] text-black font-semibold transition-all'
			>
				Todos ({totalProjects})
			</button>
			<button
				type='button'
				id='tracker-filter-favs'
				class='tracker-filter-btn px-3 py-1.5 rounded-lg border border-[var(--as-border-paper)] dark:border-[var(--border)] bg-transparent hover:border-amber-400/50 hover:text-amber-400 transition-all flex items-center gap-1 text-[var(--as-text-muted)]'
			>
				<span>★ Favoritos</span>
				<span
					id='tracker-favs-count'
					class='px-1.5 py-0.2 rounded bg-amber-400/20 text-amber-300 text-[10px]'>0</span
				>
			</button>
			<button
				type='button'
				id='tracker-reset-btn'
				class='px-2.5 py-1.5 rounded-lg text-[var(--as-text-dim)] hover:text-red-400 hover:bg-red-500/10 transition-colors'
				title='Resetar histórico local'
			>
				↺ Reset
			</button>
		</div>
	</div>

	<!-- Progress Bar -->
	<div class='mt-4 w-full'>
		<div
			class='flex items-center justify-between text-[11px] font-mono text-[var(--as-text-dim)] mb-1.5'
		>
			<span id='tracker-count-text'>0 de {totalProjects} projetos explorados</span>
			<span class='text-[10px] uppercase'>Meta: 100% de Curadoria</span>
		</div>
		<div class='h-2 w-full rounded-full bg-black/10 dark:bg-white/10 overflow-hidden relative'>
			<div
				id='tracker-progress-fill'
				class='h-full rounded-full bg-gradient-to-r from-[var(--accent-orange)] to-[var(--accent-cyan)] transition-all duration-500'
				style='width: 0%;'
			>
			</div>
		</div>
	</div>
</div>

<script>
	const initGrowthTracker = () => {
		const totalCards = document.querySelectorAll('.portfolio-card').length
		const progressFill = document.getElementById('tracker-progress-fill')
		const percentageText = document.getElementById('tracker-percentage-text')
		const countText = document.getElementById('tracker-count-text')
		const favsCountBadge = document.getElementById('tracker-favs-count')
		const filterAllBtn = document.getElementById('tracker-filter-all')
		const filterFavsBtn = document.getElementById('tracker-filter-favs')
		const resetBtn = document.getElementById('tracker-reset-btn')

		const getExplored = (): string[] => {
			try {
				return JSON.parse(localStorage.getItem('artesdosul_explored') || '[]')
			} catch {
				return []
			}
		}

		const getFavorites = (): string[] => {
			try {
				return JSON.parse(localStorage.getItem('artesdosul_favorites') || '[]')
			} catch {
				return []
			}
		}

		const updateUI = () => {
			const explored = getExplored()
			const favorites = getFavorites()

			const exploredCount = explored.length
			const percentage = totalCards > 0 ? Math.round((exploredCount / totalCards) * 100) : 0

			if (progressFill) progressFill.style.width = `${Math.min(100, percentage)}%`
			if (percentageText) percentageText.textContent = `${percentage}%`
			if (countText) countText.textContent = `${exploredCount} de ${totalCards} projetos explorados`
			if (favsCountBadge) favsCountBadge.textContent = `${favorites.length}`

			// Sync Favorite buttons on cards
			document.querySelectorAll('.favorite-btn').forEach((btn) => {
				const id = btn.getAttribute('data-project-id')
				const isFav = id && favorites.includes(id)
				btn.classList.toggle('is-favorited', !!isFav)
				const star = btn.querySelector('.star-icon')
				if (star) {
					star.textContent = isFav ? '★' : '☆'
				}
			})

			// Sync Explored status
			document.querySelectorAll('.portfolio-card').forEach((card) => {
				const id = card.getAttribute('data-project-id')
				const isExplored = id && explored.includes(id)
				card.classList.toggle('is-explored', !!isExplored)
			})
		}

		// Listen to custom updates from cards
		window.addEventListener('artesdosul:tracker_update', updateUI)

		// Filter Buttons
		filterAllBtn?.addEventListener('click', () => {
			filterAllBtn.className =
				'tracker-filter-btn px-3 py-1.5 rounded-lg border border-[var(--accent-orange)] bg-[var(--accent-orange)] text-black font-semibold transition-all'
			if (filterFavsBtn) {
				filterFavsBtn.className =
					'tracker-filter-btn px-3 py-1.5 rounded-lg border border-[var(--as-border-paper)] dark:border-[var(--border)] bg-transparent hover:border-amber-400/50 hover:text-amber-400 transition-all flex items-center gap-1 text-[var(--as-text-muted)]'
			}

			document.querySelectorAll('.portfolio-card').forEach((card) => {
				;(card as HTMLElement).style.display = ''
			})
		})

		filterFavsBtn?.addEventListener('click', () => {
			const favorites = getFavorites()
			filterFavsBtn.className =
				'tracker-filter-btn px-3 py-1.5 rounded-lg border border-amber-400 bg-amber-400 text-black font-semibold transition-all flex items-center gap-1'
			if (filterAllBtn) {
				filterAllBtn.className =
					'tracker-filter-btn px-3 py-1.5 rounded-lg border border-[var(--as-border-paper)] dark:border-[var(--border)] bg-transparent hover:text-[var(--accent-orange)] transition-all text-[var(--as-text-muted)]'
			}

			document.querySelectorAll('.portfolio-card').forEach((card) => {
				const id = card.getAttribute('data-project-id')
				const show = id && favorites.includes(id)
				;(card as HTMLElement).style.display = show ? '' : 'none'
			})
		})

		// Reset Button
		resetBtn?.addEventListener('click', () => {
			if (confirm('Deseja resetar seu histórico de exploração e favoritos salvos?')) {
				localStorage.removeItem('artesdosul_explored')
				localStorage.removeItem('artesdosul_favorites')
				updateUI()
				// Show all
				document.querySelectorAll('.portfolio-card').forEach((card) => {
					;(card as HTMLElement).style.display = ''
				})
			}
		})

		updateUI()
	}

	initGrowthTracker()
	document.addEventListener('astro:after-swap', initGrowthTracker)
</script>

<style>
	.favorite-btn.is-favorited {
		color: #fbbf24 !important;
		background: rgba(251, 191, 36, 0.15) !important;
		border-color: rgba(251, 191, 36, 0.4) !important;
	}
</style>
