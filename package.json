{
	"name": "portfolio-artesdosul",
	"type": "module",
	"version": "1.1.0",
	"description": "Portfolio Artes do Sul — Soluções para Internet. Desenvolvimento de sites, e-commerce e sistemas com 25 anos de experiência.",
	"author": "Artes do Sul",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
